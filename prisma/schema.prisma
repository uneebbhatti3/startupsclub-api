// Database schema for the StartupsClub API. Change it only through `npm run db:migrate`.
// Prisma 7: the connection URL lives in prisma.config.ts, not here.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // The NestJS app is CommonJS, so the generated client is emitted as CommonJS too.
  moduleFormat        = "cjs"
  // Extensionless relative imports, which Jest's resolver understands (it cannot map ".js" to ".ts").
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// What a waitlist signup describes themselves as. OTHER comes with free text in `roleOther`.
enum WaitlistRole {
  FOUNDER
  DEVELOPER
  OTHER

  @@map("waitlist_role")
}

/// One waitlist signup. The service stores `email` trimmed and lowercased, so the unique
/// constraint holds one row per address, and sets `roleOther` only when `role` is OTHER.
model WaitlistEntry {
  id        String       @id @default(cuid())
  name      String       @db.VarChar(100)
  email     String       @unique @db.VarChar(254)
  role      WaitlistRole
  roleOther String?      @map("role_other") @db.VarChar(50)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("waitlist_entries")
}

// ---------------------------------------------------------------------------------------------
// Authentication (better-auth 1.7). Model and field names are what better-auth's Prisma adapter
// expects; only the table and column names are mapped to snake_case. better-auth generates the
// ids itself, so no @default on them. See docs/AUTH.md.
// ---------------------------------------------------------------------------------------------

/// A person who can sign in. `email` is unique; `emailVerified` is set by better-auth after the
/// verification link is opened (or by GitHub, which only returns verified emails).
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

/// A signed-in browser. `token` is what the session cookie carries.
model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One way a user signs in: providerId "credential" holds the password hash, "github" holds the
/// GitHub account id and OAuth tokens.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("accounts")
}

/// Short-lived tokens, such as email verification links.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

# Copy to .env and fill in. Never commit .env. Agents must not read .env.
NODE_ENV=
APP_ENV=
PORT=8000
DATABASE_URL=
CORS_ORIGINS=
SENTRY_DSN=
APP_VERSION=
# Email (Resend). Required when APP_ENV is local, staging or production. Tests send nothing.
# Sender, subject and body come from the published Resend template.
RESEND_API_KEY=
RESEND_WELCOME_TEMPLATE_ID=
# Read by docker compose (local database only)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
